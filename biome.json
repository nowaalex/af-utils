{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!pnpm-lock.yaml",
            "!**/.claude/settings.local.json",
            "!**/dist",
            "!**/.astro",
            "!**/.jit",
            "!**/.stryker-tmp",
            "!**/reports/mutation"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 80
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "noAriaHiddenOnFocusable": "off",
                "noSvgWithoutTitle": "off",
                "useAnchorContent": "off",
                "useButtonType": "off",
                "useSemanticElements": "off"
            },
            "correctness": {
                "noInvalidPositionAtImportRule": "off",
                "useJsxKeyInIterable": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "arrowParentheses": "asNeeded",
            "jsxQuoteStyle": "double",
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "none"
        }
    },
    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true
        }
    }
}
