{
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "name": "workspace",
    "root": ".",
    "projectType": "application",
    "tags": ["workspace:root"],
    "targets": {
        "format-oxc": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "oxfmt .",
                "cwd": "."
            }
        },
        "format-templates": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "prettier --plugin=prettier-plugin-astro --plugin=prettier-plugin-svelte --write \"website/src/**/*.astro\" \"examples/src/**/*.svelte\"",
                "cwd": "."
            }
        },
        "format": {
            "executor": "nx:noop",
            "cache": false,
            "dependsOn": ["format-oxc", "format-templates"]
        },
        "site-origin-sync": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "node scripts/sync-site-origin.mjs",
                "cwd": "."
            }
        },
        "site-origin-test": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "{workspaceRoot}/site.config.json",
                "{workspaceRoot}/scripts/sync-site-origin.mjs",
                "{workspaceRoot}/scripts/sync-site-origin.test.mjs"
            ],
            "options": {
                "command": "node --test scripts/sync-site-origin.test.mjs",
                "cwd": "."
            }
        },
        "site-origin-check": {
            "executor": "nx:run-commands",
            "cache": true,
            "dependsOn": ["site-origin-test"],
            "inputs": [
                "default",
                "{workspaceRoot}/site.config.json",
                "{workspaceRoot}/scripts/sync-site-origin.mjs"
            ],
            "options": {
                "command": "node scripts/sync-site-origin.mjs --check",
                "cwd": "."
            }
        },
        "format-check-oxc": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "oxfmt --check .",
                "cwd": "."
            }
        },
        "format-check-templates": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "prettier --plugin=prettier-plugin-astro --plugin=prettier-plugin-svelte --check \"website/src/**/*.astro\" \"examples/src/**/*.svelte\"",
                "cwd": "."
            }
        },
        "format-check": {
            "executor": "nx:noop",
            "cache": true,
            "dependsOn": ["format-check-oxc", "format-check-templates"]
        },
        "lint": {
            "executor": "nx:noop",
            "cache": true,
            "dependsOn": ["lint-fast", "lint-type-aware"]
        },
        "lint-fast": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "oxlint .",
                "cwd": "."
            }
        },
        "lint-type-aware": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "oxlint -c .oxlintrc.type-aware.json packages/virtual",
                "cwd": "."
            }
        },
        "check-style": {
            "executor": "nx:noop",
            "cache": true,
            "dependsOn": ["format-check", "lint", "site-origin-check"]
        },
        "packages-readmes-check": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "node scripts/check-package-readmes.mjs",
                "cwd": "."
            }
        },
        "nx-contracts-check": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "node scripts/check-nx-workspace.mjs",
                "cwd": "."
            }
        },
        "website-generated-check": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": [
                {
                    "target": "generate",
                    "projects": ["website"]
                }
            ],
            "options": {
                "command": "node scripts/check-website-generated.mjs",
                "cwd": "."
            }
        },
        "lighthouse": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": [
                {
                    "target": "build",
                    "projects": ["website"]
                }
            ],
            "options": {
                "command": "node scripts/run-lighthouse.mjs",
                "cwd": "."
            }
        }
    }
}
