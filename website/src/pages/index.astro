---
import { getImage } from "astro:assets";
import sizifImg from "assets/sizif.jpg";
import { Icon } from "astro-icon/components";
import FrameworkIcon from "components/FrameworkIcon.astro";
import Layout from "layouts/Base.astro";
import { exampleFrameworks } from "@af-utils/examples/config";

const sizif = await getImage({ src: sizifImg, quality: 16 });
---

<style define:vars={{ bg: `url(${sizif.src})` }}>
    @media only screen and (min-width: 1024px) {
        main {
            background: var(--bg) no-repeat right bottom / 37%;
            padding-right: 0;
        }
    }

    @media only screen and (min-width: 1660px) {
        main {
            background-size: contain;
        }
    }
</style>
<Layout
    titleTemplate="af-utils | %s"
    title="Practical open-source utilities"
    description="Practical open-source utilities."
>
    <link
        slot="head"
        rel="preload"
        href={sizif.src}
        as="image"
        media="only screen and (min-width: 1024px)"
    />
    <div
        class="prose flex h-screen w-screen flex-col bg-gradient-to-br from-violet-50 via-white to-cyan-50"
    >
        <header
            class="prose-lg prose-a:no-underline mx-[5vmin] flex justify-center gap-8 border-b border-violet-200 p-6"
        >
            <a
                href={`https://github.com/${import.meta.env.PUBLIC_GITHUB_SUFFIX}`}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 px-3 py-1 transition-colors hover:bg-white/80 hover:text-violet-800"
            >
                <Icon name="logos:github-icon" size={22} />Github
            </a>
            <a
                href={import.meta.env.PUBLIC_DISCORD_LINK}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 px-3 py-1 transition-colors hover:bg-white/80 hover:text-violet-800"
            >
                <Icon name="logos:discord-icon" size={22} />Discord
            </a>
        </header>
        <main
            data-pagefind-body
            class="prose-xl prose-a:text-violet-700 prose-a:no-underline flex-auto px-[5vmin] py-12"
        >
            <h1>af-utils/*</h1>
            <p>Practical open-source utilities.</p>
            <ul>
                <li>
                    <a href="/virtual">Virtual scroll</a>{" "}
                    for rendering only visible part of huge lists or grids
                    <span
                        role="img"
                        class="not-prose ml-2 inline-flex translate-y-0.5 items-center gap-1.5"
                        aria-label={`Available for ${exampleFrameworks.join(", ")}`}
                    >
                        {
                            exampleFrameworks.map((framework) => (
                                <FrameworkIcon
                                    framework={framework}
                                    size={18}
                                />
                            ))
                        }
                    </span>
                </li>
                <li>
                    <a href="/scrollend-polyfill">Scrollend polyfill</a>{" "}
                    for cross-browser scrollend event support
                </li>
                <li>To be continued...</li>
            </ul>
        </main>
        <footer class="mx-[5vmin] border-t border-cyan-200 p-6 text-center">
            © {new Date().getFullYear()} Alex Fomin
        </footer>
    </div>
</Layout>
