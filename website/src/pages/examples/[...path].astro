---
import HeadFont from "components/head/Font.astro";
import ExamplePreviews from "generated/ExamplePreviews.astro";
import { codes } from "utils/examples";

export function getStaticPaths() {
    return Object.keys(codes).map(path => ({
        params: { path },
        props: { path }
    }));
}

const { path } = Astro.props;
const canonicalPath = path.replace(/\//, "/examples/");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <HeadFont />
        <link
            rel="canonical"
            href={new URL(canonicalPath, import.meta.env.PUBLIC_ORIGIN)}
        >
        <style>
        html,
        body {
            padding: 0;
            margin: 0;
        }

        body {
            color: #374151;
        }

        #root {
            display: grid;
            height: 100vh;
        }
        </style>
    </head>
    <body>
        <div id="root">
            <ExamplePreviews path={path} />
        </div>
    </body>
</html>
