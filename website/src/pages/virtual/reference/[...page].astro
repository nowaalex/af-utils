---
import { getCollection, render } from "astro:content";
import ReferenceExamples from "components/ReferenceExamples.astro";
import VirtualDocumentation from "layouts/virtual/VirtualDocumentation.astro";
import { getRelatedExamples } from "utils/examples";

export async function getStaticPaths() {
    const entries = await getCollection("reference");

    return entries.map((entry) => ({
        params: { page: entry.id },
        props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedExamples = await getRelatedExamples(entry.data);
---

<VirtualDocumentation
    title={`${entry.data.title} reference`}
    description={entry.data.description}
    mainClass="reference-doc"
>
    <Content />
    <ReferenceExamples examples={relatedExamples} />
</VirtualDocumentation>
