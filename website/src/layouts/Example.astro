---
import ExampleHeader from "components/ExampleHeader.astro";
import ExampleTabs from "components/ExampleTabs/index.astro";
import startCase from "lodash/startCase";
import {
    getAlternativeExamples,
    getExampleDescription,
    getExampleFiles,
    getExamplePagePath,
    readmes
} from "utils/examples";

interface Props {
    path: string;
    wrapper: astroHTML.JSX.Element;
}

const { path, wrapper: W } = Astro.props;
const loadDescription = readmes[path];
if (!loadDescription) throw new Error(`Missing example README: ${path}`);
const Description = await loadDescription();
const description = await getExampleDescription(path);
const titleBase = startCase(path.split("/").reverse().join(" "));
const alternatives = getAlternativeExamples(path);
---

<W
    title={`${titleBase} Example`}
    description={description}
    mainClass="flex flex-col prose-p:m-0 gap-2"
>
    <ExampleHeader path={path} class="mb-6" />
    <Description />
    {
        alternatives.length > 0 && (
            <p class="text-sm text-slate-600">
                Available also for{" "}
                {alternatives.map((example, index) => (
                    <>
                        {index > 0 && ", "}
                        <a href={getExamplePagePath(example.route)}>
                            {startCase(example.framework)}
                        </a>
                    </>
                ))}
                .
            </p>
        )
    }
    <ExampleTabs path={path} title={titleBase} files={getExampleFiles(path)} />
</W>
