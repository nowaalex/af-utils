---
import { getImage } from "astro:assets";
import { exampleFrameworks } from "@af-utils/examples/config";
import ogVirtual from "assets/og/virtual.png";
import type { MenuItem } from "components/Menu.astro";
import Documentation from "layouts/Documentation.astro";
import defaultsDeep from "lodash/defaultsDeep";
import { getMenuMapForProjectExamples } from "utils/examples";
import {
    frameworkPresentation,
    virtualAdapterPackages
} from "utils/frameworks";

export type { Props } from "layouts/Documentation.astro";

import type { CollectionEntry } from "astro:content";
import referenceNavigation from "../../content/reference/navigation.json";

const getReferencePath = (path: string | null | undefined) =>
    path ? `/virtual/reference/${path}` : "/virtual/reference/index";

interface ReferenceNavigationItem {
    title: string;
    path?: string | null;
    children?: ReferenceNavigationItem[];
}

const mapReferenceNavigation = (item: ReferenceNavigationItem): MenuItem => {
    const children = item.children?.map(mapReferenceNavigation);
    return {
        name: item.title,
        path: getReferencePath(item.path),
        ...(children ? { children } : {})
    };
};

const referenceItems = referenceNavigation.map((item) => {
    const mapped = mapReferenceNavigation(item);
    const packageName = item.title;
    const frameworkName = exampleFrameworks.find(
        (_, index) => virtualAdapterPackages[index] === packageName
    );
    const framework = frameworkName
        ? frameworkPresentation[frameworkName]
        : undefined;
    return {
        ...mapped,
        name: packageName.replace("@af-utils/virtual-", ""),
        collapsible: true,
        icon: framework?.icon ?? "material-symbols:data-object",
        ...(framework?.iconClass ? { iconClass: framework.iconClass } : {}),
        children: [
            {
                name: "Overview",
                path: mapped.path,
                exact: true
            },
            ...(mapped.children ?? [])
        ]
    };
});

const items = [
    {
        name: "Description",
        path: "",
        children: [
            {
                name: "Getting started",
                path: "/virtual",
                exact: true
            },
            {
                name: "FAQ",
                path: "/virtual/faq"
            },
            {
                name: "Bundle size impact",
                path: "/virtual/size"
            }
        ]
    },
    {
        name: "Guides",
        path: "/virtual/guides",
        children: [
            {
                name: "Render ownership",
                path: "/virtual/guides/render-ownership"
            },
            {
                name: "Layout elements",
                path: "/virtual/guides/layout-elements"
            },
            {
                name: "Custom rendering",
                path: "/virtual/guides/custom-rendering"
            }
        ]
    },
    {
        name: "Reference",
        path: "/virtual/reference/index",
        children: [
            {
                name: "Overview",
                path: `/virtual/reference/${"index" satisfies CollectionEntry<"reference">["id"]}`,
                exact: true
            },
            ...referenceItems
        ]
    },
    ...getMenuMapForProjectExamples("virtual")
];

const img = await getImage({ src: ogVirtual, quality: 20, format: "png" });

const props = defaultsDeep(Astro.props, {
    openGraph: {
        basic: {
            image: img.src
        }
    }
});
---

<Documentation
    {...props}
    titleTemplate="%s | af-utils | Virtual"
    items={items}
    productName="virtual"
>
    <slot />
</Documentation>
