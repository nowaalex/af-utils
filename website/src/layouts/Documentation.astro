---
import type { MenuItem } from "components/Menu.astro";
import Menu from "components/Menu.astro";
import NextPrevBlock from "components/NextPrevBlock.astro";
import type { Props as BaseLayoutProps } from "layouts/Base.astro";
import BaseLayout from "./Base.astro";

function flattenMenu(arr: MenuItem[] | readonly MenuItem[]): MenuItem[] {
    return arr.flatMap((k) =>
        k.children?.length ? flattenMenu(k.children) : k
    );
}

export interface Props extends BaseLayoutProps {
    items: MenuItem[];
    productName: string;
    contentClass?: string;
    mainClass?: string;
}

const {
    items,
    productName,
    contentClass = "mx-auto max-w-4xl",
    mainClass,
    ...rest
} = Astro.props;

const flattenedItems = flattenMenu(items);
---

<BaseLayout {...rest}>
    <div class="h-screen flex flex-col lg:flex-row">
        <Menu
            items={items}
            productName={productName}
            class="lg:w-68 lg:min-w-68 lg:max-w-68"
        />
        <div
            class="documentation-scroll min-w-0 flex flex-auto flex-col gap-8 overflow-auto bg-gradient-to-br from-white via-white to-slate-50 p-4"
        >
            <main
                data-pagefind-body
                class:list={["prose w-full flex-auto", contentClass, mainClass]}
            >
                <slot />
            </main>
            <nav
                class:list={[
                    "flex w-full flex-none items-center justify-between gap-4 font-medium",
                    contentClass
                ]}
            >
                <NextPrevBlock items={flattenedItems} />
            </nav>
        </div>
    </div>
</BaseLayout>
