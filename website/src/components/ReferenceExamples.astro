---
import type { RelatedExample } from "utils/examples";

interface Props {
    examples: RelatedExample[];
}

const { examples } = Astro.props;
---

{
    examples.length > 0 && (
        <section
            aria-labelledby="related-examples"
            class="not-prose mt-12 border-t border-violet-200 pt-8"
        >
            <h2
                id="related-examples"
                class="mb-4 text-2xl font-semibold text-slate-900"
            >
                Related examples
            </h2>
            <ul class="m-0 grid list-none gap-3 p-0 md:grid-cols-2">
                {examples.map((example) => (
                    <li>
                        <a
                            href={example.path}
                            class="block h-full border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-violet-300 hover:bg-violet-50"
                        >
                            <span class="mb-2 flex items-center justify-between gap-3">
                                <strong class="font-semibold text-violet-800">
                                    {example.title}
                                </strong>
                                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-slate-600">
                                    {example.framework}
                                </span>
                            </span>
                            <span class="block text-sm leading-6 text-slate-600">
                                {example.description}
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    )
}
