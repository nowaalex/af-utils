---
interface Props {
    label: string;
    name: string;
    selected?: boolean;
    tabId: string;
}

const { label, name, selected = false, tabId } = Astro.props;
---

<button
    type="button"
    role="tab"
    id={`${tabId}-${name}-tab`}
    aria-controls={`${tabId}-${name}-panel`}
    aria-selected={selected}
    tabindex={selected ? 0 : -1}
    data-example-tab={name}
    class="cursor-pointer whitespace-nowrap border-b-2 border-transparent px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-200/70 hover:text-slate-900 aria-selected:border-blue-500 aria-selected:bg-white aria-selected:text-slate-950"
>
    {label}
</button>
