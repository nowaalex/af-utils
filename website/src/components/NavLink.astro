---
import stripTrailingSlash from "utils/stripTrailingSlash";

const currentPath = stripTrailingSlash(Astro.url.pathname);

const {
    href,
    compareHref = href,
    exact,
    class: className,
    ...rest
} = Astro.props;

const isActive = exact
    ? currentPath === compareHref
    : typeof compareHref === "string" &&
      (currentPath === compareHref ||
          currentPath.startsWith(`${compareHref}/`));
---

<a
    {...rest}
    href={href}
    aria-current={isActive ? "page" : undefined}
    class:list={[
        "block border-l-2 border-transparent px-2 py-1 font-normal no-underline transition-colors hover:bg-slate-200 hover:text-slate-950",
        isActive && "border-blue-500 bg-blue-100 text-blue-950 !font-semibold",
        className
    ]}
>
    <slot />
</a>
