---
import stripTrailingSlash from "utils/stripTrailingSlash";

const currentPath = stripTrailingSlash(Astro.url.pathname);

const {
    href,
    compareHref = href,
    exact,
    class: className,
    ...rest
} = Astro.props;

const isActive = exact
    ? currentPath === compareHref
    : typeof compareHref === "string" && currentPath.startsWith(compareHref);
---

<a
    {...rest}
    href={href}
    aria-current={isActive ? "page" : undefined}
    class:list={[
        "block px-2 py-1 font-normal no-underline transition-colors hover:bg-violet-100 hover:text-violet-800",
        isActive && "bg-orange-100 text-orange-800 !font-semibold",
        className
    ]}
>
    <slot />
</a>
