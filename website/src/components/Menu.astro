---
import { Icon } from "astro-icon/components";
import Breadcrumb from "./Breadcrumb.astro";
import MenuSubtree from "./MenuSubtree.astro";

export interface MenuItem {
    name: string;
    path: string;
    icon?: string;
    iconClass?: string;
    exact?: boolean;
    comparePath?: string;
    collapsible?: boolean;
    children?: readonly MenuItem[] | MenuItem[];
}

const { items, productName, class: className } = Astro.props;

interface Props {
    items: readonly MenuItem[] | MenuItem[];
    productName: string;
    class?: string;
}
---

<input aria-hidden="true" type="checkbox" class="ds-menu-checkbox hidden" />
<div
    class:list={[
        "flex flex-col lg:overflow-y-auto lg:border-r lg:drop-shadow-sm",
        className
    ]}
>
    <div
        class="flex-none sticky top-0 flex items-center h-[62px] gap-4 border-slate-200 border-b bg-menu px-4 z-[20] drop-shadow-sm lg:drop-shadow-none"
    >
        <button class="ds-menu-opener hidden">
            <Icon
                size={24}
                name="material-symbols:menu"
                aria-label="open menu"
                class="text-blue-700"
            />
        </button>
        <button class="ds-menu-closer hidden">
            <Icon
                size={24}
                name="material-symbols:close"
                aria-label="close menu"
                class="text-rose-600"
            />
        </button>
        <Breadcrumb>
            {productName}
        </Breadcrumb>
    </div>
    <nav
        aria-label="Main navigation"
        class="ds-menu-items z-10 flex-auto bg-menu p-4 text-sm"
    >
        {items.map((node) => <MenuSubtree node={node} depth={0} />)}

        <h2 class="mb-2 mt-5 text-base font-semibold">Links</h2>

        <ul class="m-0 list-none space-y-1 pl-3">
            <li>
                <a
                    href={`https://github.com/${import.meta.env.PUBLIC_GITHUB_SUFFIX}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-2 py-1 font-normal no-underline transition-colors hover:bg-slate-200 hover:text-slate-950"
                >
                    <Icon name="logos:github-icon" size={20} />Github
                </a>
            </li>
            <li>
                <a
                    href={import.meta.env.PUBLIC_DISCORD_LINK}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-2 py-1 font-normal no-underline transition-colors hover:bg-indigo-100 hover:text-indigo-900"
                >
                    <Icon name="logos:discord-icon" size={20} />Discord
                </a>
            </li>
        </ul>
    </nav>
</div>
<menu-events-appender hidden></menu-events-appender>
<script>
    class MenuEventsAppender extends HTMLElement {
        /** Connects the mobile menu disclosure and navigation handlers. */
        constructor() {
            super();

            const menu =
                document.querySelector<HTMLInputElement>(".ds-menu-checkbox");
            if (!menu) return;

            const toggleMenu = () => menu.toggleAttribute("checked");

            document
                .querySelectorAll(".ds-menu-opener, .ds-menu-closer")
                .forEach((btn) => {
                    btn.addEventListener("click", toggleMenu);
                });

            document
                .querySelector(".ds-menu-items")
                ?.addEventListener("click", (e) => {
                    if (
                        e.target instanceof HTMLAnchorElement &&
                        e.target.getAttribute("href")?.startsWith("/")
                    ) {
                        toggleMenu();
                    }
                });

            const activeItem = document.querySelector<HTMLElement>(
                '.ds-menu-items [aria-current="page"]'
            );
            if (!activeItem) return;

            let parent = activeItem.parentElement;
            while (parent) {
                if (parent instanceof HTMLDetailsElement) parent.open = true;
                parent = parent.parentElement;
            }

            requestAnimationFrame(() => {
                activeItem.scrollIntoView({ block: "nearest" });
            });
        }
    }

    customElements.define("menu-events-appender", MenuEventsAppender);
</script>
