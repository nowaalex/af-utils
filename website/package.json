{
    "name": "website",
    "type": "module",
    "private": true,
    "version": "0.0.7",
    "scripts": {
        "dev": "pnpm build:examples && pnpm format:generated && astro dev",
        "build": "pnpm weigh-exports && pnpm build:examples && pnpm format:generated && pnpm build:docs && astro check && astro build",
        "weigh-exports": "weigh-exports -i '../packages/virtual/core ../packages/virtual/react ../packages/scrollend-polyfill' -o ./src/bundleSizes.ts",
        "start": "astro dev",
        "build:examples": "tsx ./build-examples.ts",
        "format:generated": "biome format --write ./src/bundleSizes.ts ./src/pages/examples",
        "build:docs": "./build-docs.sh",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@af-utils/examples": "workspace:*",
        "@af-utils/scrollend-polyfill": "workspace:*",
        "@af-utils/virtual-core": "workspace:*",
        "@af-utils/virtual-react": "workspace:*",
        "@astrojs/check": "^0.9.10",
        "@astrojs/markdown-remark": "^7.2.2",
        "@astrojs/react": "^6.0.2",
        "@astrojs/sitemap": "^3.7.3",
        "@iconify-json/material-symbols": "^1.2.88",
        "@iconify-json/simple-icons": "^1.2.93",
        "astro": "^7.2.0",
        "astro-icon": "^1.1.5",
        "astro-seo": "^1.1.0",
        "pretty-bytes": "^7.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sharp": "^0.35.3",
        "sharp-ico": "^0.1.5",
        "shiki": "4.4.2",
        "vite": "^8.2.1"
    },
    "devDependencies": {
        "@af-utils/weigh-exports": "workspace:*",
        "@astrojs/mdx": "^7.0.5",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/lodash": "^4.17.25",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "fast-glob": "^3.3.3",
        "lodash": "^4.18.1",
        "node-html-parser": "^9.0.1",
        "rehype-pretty-code": "^0.14.5",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "4.0.1",
        "remark-toc": "^9.0.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.11",
        "unist-util-visit": "^5.1.0"
    }
}
