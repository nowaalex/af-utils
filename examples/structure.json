{
    "sourceDirectory": "src",
    "frameworks": {
        "lit": {
            "entryFile": "src/code.ts",
            "adapterPackage": "@af-utils/virtual-lit",
            "adapterDirectory": "packages/virtual/lit",
            "template": "lit",
            "build": "tsc && vite build",
            "icon": "logos:lit-icon",
            "dependencies": ["lit"],
            "devDependencies": [],
            "customElementTag": null
        },
        "preact": {
            "entryFile": "src/code.tsx",
            "adapterPackage": "@af-utils/virtual-preact",
            "adapterDirectory": "packages/virtual/preact",
            "template": "preact",
            "build": "tsc && vite build",
            "icon": "logos:preact",
            "dependencies": ["preact"],
            "devDependencies": ["@preact/preset-vite"],
            "customElementTag": null
        },
        "react": {
            "entryFile": "src/code.tsx",
            "adapterPackage": "@af-utils/virtual-react",
            "adapterDirectory": "packages/virtual/react",
            "icon": "logos:react",
            "dependencies": [],
            "devDependencies": [],
            "customElementTag": null
        },
        "solid": {
            "entryFile": "src/code.tsx",
            "adapterPackage": "@af-utils/virtual-solid",
            "adapterDirectory": "packages/virtual/solid",
            "template": "solid",
            "build": "tsc && vite build",
            "icon": "simple-icons:solid",
            "iconClass": "text-[#2c4f7c]",
            "dependencies": ["solid-js"],
            "devDependencies": ["vite-plugin-solid"],
            "customElementTag": null
        },
        "svelte": {
            "entryFile": "src/code.svelte",
            "adapterPackage": "@af-utils/virtual-svelte",
            "adapterDirectory": "packages/virtual/svelte",
            "template": "svelte",
            "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
            "icon": "logos:svelte-icon",
            "dependencies": ["svelte"],
            "devDependencies": ["@sveltejs/vite-plugin-svelte", "svelte-check"],
            "customElementTag": null
        },
        "vue": {
            "entryFile": "src/code.vue",
            "adapterPackage": "@af-utils/virtual-vue",
            "adapterDirectory": "packages/virtual/vue",
            "template": "vue",
            "build": "vue-tsc && vite build",
            "icon": "logos:vue",
            "dependencies": ["vue"],
            "devDependencies": ["@vitejs/plugin-vue", "vue-tsc"],
            "customElementTag": null
        },
        "core": {
            "entryFile": "src/code.ts",
            "adapterPackage": "@af-utils/virtual-core",
            "adapterDirectory": "packages/virtual/core",
            "template": "core",
            "build": "tsc && vite build",
            "icon": "logos:typescript-icon",
            "dependencies": [],
            "devDependencies": [],
            "customElementTag": "virtual-core-example"
        }
    }
}
