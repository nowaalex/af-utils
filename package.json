{
    "private": true,
    "type": "module",
    "name": "af-utils-monorepo",
    "engines": {
        "pnpm": ">=11.21.0",
        "node": ">=24.19.0"
    },
    "packageManager": "pnpm@11.21.0",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nowaalex/af-utils"
    },
    "homepage": "https://af-utils.vercel.app",
    "license": "MIT",
    "scripts": {
        "nx": "nx",
        "format": "nx run workspace:format",
        "format:oxc": "nx run workspace:format-oxc",
        "format:templates": "nx run workspace:format-templates",
        "format:check": "nx run workspace:format-check",
        "format:check:oxc": "nx run workspace:format-check-oxc",
        "format:check:templates": "nx run workspace:format-check-templates",
        "lint": "nx run workspace:lint",
        "check:style": "nx run workspace:check-style",
        "test": "nx run-many -t test",
        "test:e2e": "nx run @af-utils/examples:e2e",
        "test:e2e:install": "playwright install chromium firefox",
        "test:mutation": "nx run @af-utils/virtual-core:test:mutation",
        "bench": "nx run-many -t bench",
        "jit:check": "nx run @af-utils/virtual-core:jit:check",
        "typecheck": "nx run-many -t typecheck",
        "packages:build": "nx run-many -t build --projects=\"tag:npm:public\"",
        "build": "nx run-many -t build --projects=\"tag:npm:public,website\"",
        "publint": "nx run-many -t publint --projects=tag:npm:public",
        "packages:readmes:check": "nx run workspace:packages-readmes-check",
        "nx:contracts:check": "nx run workspace:nx-contracts-check",
        "site:sync": "nx run workspace:site-origin-sync",
        "site:sync:check": "nx run workspace:site-origin-check",
        "examples:build": "nx run-many -t build --projects=\"examples/**\"",
        "examples:sync": "nx run @af-utils/examples:sync",
        "examples:sync:check": "nx run @af-utils/examples:sync:check",
        "workspace:sync": "nx run @af-utils/examples:versions",
        "workspace:sync:check": "nx run @af-utils/examples:versions:check",
        "website:generated:check": "nx run workspace:website-generated-check",
        "hooks:install": "git config core.hooksPath .githooks",
        "prepare": "pnpm hooks:install",
        "changeset:version": "changeset version && pnpm nx run @af-utils/examples:versions && pnpm install --lockfile-only --no-frozen-lockfile",
        "release": "changeset publish"
    },
    "browserslist": ">0.6%, not op_mini all",
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@microsoft/api-extractor": "^7.58.12",
        "@playwright/test": "1.62.1",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "@types/node": "^24.13.3",
        "nx": "23.1.1",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-svelte": "4.1.1",
        "publint": "^0.3.23",
        "typedoc": "0.28.20",
        "typedoc-plugin-frontmatter": "1.3.1",
        "typedoc-plugin-markdown": "4.12.0",
        "typescript": "^6.0.3"
    }
}
