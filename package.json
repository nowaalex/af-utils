{
    "private": true,
    "type": "module",
    "name": "af-utils-monorepo",
    "engines": {
        "pnpm": ">=11.21.0",
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@11.21.0",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nowaalex/af-utils"
    },
    "homepage": "https://af-utils.com",
    "license": "MIT",
    "scripts": {
        "format": "pnpm format:oxc && pnpm format:astro",
        "format:oxc": "oxfmt .",
        "format:astro": "prettier --write \"website/src/**/*.astro\"",
        "format:check": "pnpm format:check:oxc && pnpm format:check:astro",
        "format:check:oxc": "oxfmt --check .",
        "format:check:astro": "prettier --check \"website/src/**/*.astro\"",
        "lint": "oxlint .",
        "check:style": "pnpm format:check && pnpm lint",
        "test": "pnpm -r test",
        "test:e2e": "pnpm test:examples",
        "test:e2e:install": "playwright install chromium firefox",
        "test:examples": "pnpm build && pnpm examples:build && playwright test",
        "test:mutation": "pnpm --filter @af-utils/virtual-core test:mutation",
        "bench": "pnpm --filter @af-utils/virtual-core bench && pnpm --filter @af-utils/virtual-react bench",
        "jit:check": "pnpm --filter @af-utils/virtual-core jit:check",
        "typecheck": "pnpm packages exec tsc --noEmit",
        "packages": "pnpm -F './packages/**'",
        "build": "pnpm packages -F website build",
        "publint": "pnpm packages exec publint",
        "examples:versions": "node scripts/sync-example-package-versions.mjs",
        "examples:versions:check": "node scripts/sync-example-package-versions.mjs --check",
        "examples:build": "pnpm -r --filter './examples/**' run --if-present build",
        "examples:sync": "node scripts/sync-examples.mjs",
        "examples:sync:check": "node scripts/sync-examples.mjs --check",
        "hooks:install": "git config core.hooksPath .githooks",
        "prepare": "pnpm hooks:install",
        "changeset:version": "changeset version && pnpm examples:versions && pnpm install --lockfile-only --no-frozen-lockfile",
        "release": "changeset publish"
    },
    "browserslist": ">0.6%, not op_mini all",
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@microsoft/api-extractor": "^7.58.12",
        "@playwright/test": "1.62.1",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/node": "^26.2.0",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "publint": "^0.3.23",
        "typedoc": "0.28.20",
        "typedoc-plugin-frontmatter": "1.3.1",
        "typedoc-plugin-markdown": "4.12.0",
        "typescript": "^6.0.3"
    }
}
