{
    "private": true,
    "type": "module",
    "name": "af-utils-monorepo",
    "engines": {
        "pnpm": ">=11.21.0",
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@11.21.0",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nowaalex/af-utils"
    },
    "homepage": "https://af-utils.com",
    "license": "MIT",
    "scripts": {
        "nx": "nx",
        "format": "pnpm format:oxc && pnpm format:templates",
        "format:oxc": "oxfmt .",
        "format:templates": "prettier --plugin=prettier-plugin-astro --plugin=prettier-plugin-svelte --write \"website/src/**/*.astro\" \"examples/src/**/*.svelte\"",
        "format:check": "pnpm format:check:oxc && pnpm format:check:templates",
        "format:check:oxc": "oxfmt --check .",
        "format:check:templates": "prettier --plugin=prettier-plugin-astro --plugin=prettier-plugin-svelte --check \"website/src/**/*.astro\" \"examples/src/**/*.svelte\"",
        "lint": "oxlint .",
        "check:style": "pnpm format:check && pnpm lint",
        "test": "nx run-many -t test",
        "test:e2e": "nx run @af-utils/examples:e2e",
        "test:e2e:install": "playwright install chromium firefox",
        "test:examples": "nx run @af-utils/examples:e2e",
        "test:mutation": "nx run @af-utils/virtual-core:test:mutation",
        "bench": "nx run-many -t bench",
        "jit:check": "nx run @af-utils/virtual-core:jit:check",
        "typecheck": "nx run-many -t typecheck",
        "packages:build": "nx run-many -t build --projects=\"tag:npm:public\"",
        "build": "nx run-many -t build --projects=\"tag:npm:public,website\"",
        "publint": "pnpm --filter './packages/**' exec publint",
        "examples:versions": "nx run @af-utils/examples:versions",
        "examples:versions:check": "nx run @af-utils/examples:versions:check",
        "examples:build": "nx run-many -t build --projects=\"examples/**\"",
        "examples:sync": "nx run @af-utils/examples:sync",
        "examples:sync:check": "nx run @af-utils/examples:sync:check",
        "workspace:sync": "nx run @af-utils/examples:versions",
        "workspace:sync:check": "nx run @af-utils/examples:versions:check",
        "website:generated:check": "test -z \"$(git status --porcelain=v1 --untracked-files=all -- website/src/bundleSizes.ts website/src/content/reference)\"",
        "hooks:install": "git config core.hooksPath .githooks",
        "prepare": "pnpm hooks:install",
        "changeset:version": "changeset version && pnpm workspace:sync && pnpm install --lockfile-only --no-frozen-lockfile",
        "release": "changeset publish"
    },
    "browserslist": ">0.6%, not op_mini all",
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@microsoft/api-extractor": "^7.58.12",
        "@playwright/test": "1.62.1",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/node": "^26.2.0",
        "nx": "23.1.1",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-svelte": "4.1.1",
        "publint": "^0.3.23",
        "typedoc": "0.28.20",
        "typedoc-plugin-frontmatter": "1.3.1",
        "typedoc-plugin-markdown": "4.12.0",
        "typescript": "^6.0.3"
    }
}
