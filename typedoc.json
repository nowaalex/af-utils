{
    "$schema": "./node_modules/typedoc-plugin-markdown/typedoc-plugin-markdown.schema.json",
    "entryPoints": ["packages/virtual/*"],
    "entryPointStrategy": "packages",
    "packageOptions": {
        "entryPoints": ["src/index.ts"]
    },
    "plugin": [
        "typedoc-plugin-markdown",
        "./website/plugins/typedoc.mjs",
        "typedoc-plugin-frontmatter"
    ],
    "theme": "markdown",
    "router": "member",
    "out": "website/src/content/reference",
    "cleanOutputDir": true,
    "entryFileName": "index",
    "publicPath": "/virtual/reference/",
    "navigationJson": "website/src/content/reference/navigation.json",
    "readme": "none",
    "hidePageHeader": true,
    "hideBreadcrumbs": true,
    "pageTitleTemplates": {
        "index": "API reference",
        "member": "{name}",
        "module": "{name}"
    },
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "validation": {
        "invalidLink": true,
        "invalidPath": true,
        "notDocumented": true,
        "notExported": true,
        "rewrittenLink": true,
        "unusedMergeModuleWith": true
    },
    "treatValidationWarningsAsErrors": true,
    "excludeScopesInPaths": true,
    "disableSources": true,
    "externalSymbolLinkMappings": {
        "@af-utils/virtual-core": {
            "VirtualScroller": "/virtual/reference/virtual-core/classes/VirtualScroller",
            "VirtualScroller.set": "/virtual/reference/virtual-core/classes/VirtualScroller#set",
            "VirtualScrollerEventMask": "/virtual/reference/virtual-core/type-aliases/VirtualScrollerEventMask",
            "VirtualScrollerInitialParams": "/virtual/reference/virtual-core/interfaces/VirtualScrollerInitialParams",
            "VirtualScrollerScrollElement": "/virtual/reference/virtual-core/type-aliases/VirtualScrollerScrollElement"
        }
    },
    "githubPages": false,
    "includeVersion": false,
    "useCodeBlocks": true,
    "formatWithPrettier": false,
    "indexFormat": "list",
    "interfacePropertiesFormat": "list",
    "classPropertiesFormat": "list",
    "typeAliasPropertiesFormat": "list",
    "enumMembersFormat": "table",
    "propertyMembersFormat": "list",
    "typeDeclarationFormat": "list",
    "parametersFormat": "list",
    "frontmatterGlobals": {
        "generated": true
    }
}
