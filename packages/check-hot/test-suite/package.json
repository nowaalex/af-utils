{
    "name": "@af-utils/check-hot-test-runners",
    "private": true,
    "version": "0.1.0",
    "description": "Optional ecosystem-specific sample recipes for @af-utils/check-hot",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/check-hot/test-suite"
    },
    "homepage": "https://github.com/nowaalex/af-utils/tree/main/packages/check-hot/test-suite",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "type": "module",
    "files": [
        "dist",
        "README.md"
    ],
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js",
    "exports": {
        "./README.md": "./README.md",
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./auto": {
            "types": "./dist/auto.d.ts",
            "default": "./dist/auto.js"
        },
        "./generic": {
            "types": "./dist/generic.d.ts",
            "default": "./dist/generic.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./svelte": {
            "types": "./dist/svelte.d.ts",
            "default": "./dist/svelte.js"
        },
        "./three": {
            "types": "./dist/three.d.ts",
            "default": "./dist/three.js"
        },
        "./lodash": {
            "types": "./dist/lodash.d.ts",
            "default": "./dist/lodash.js"
        },
        "./date-fns": {
            "types": "./dist/date-fns.d.ts",
            "default": "./dist/date-fns.js"
        }
    },
    "nx": {
        "targets": {
            "audit:threejs": {
                "dependsOn": [
                    "build"
                ]
            },
            "test": {
                "executor": "nx:noop",
                "dependsOn": [
                    "test:fast",
                    "test:ecosystem:lodash",
                    "test:ecosystem:date-fns",
                    "test:ecosystem:react",
                    "test:ecosystem:svelte",
                    "test:ecosystem:three"
                ]
            },
            "test:fast": {
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [
                    "build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    "checkHotRuntimeControls"
                ],
                "options": {
                    "command": "vitest run",
                    "cwd": "packages/check-hot/test-suite",
                    "env": {
                        "CHECK_HOT_ECOSYSTEM": "none"
                    }
                }
            },
            "test:ecosystem:lodash": {
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [
                    "build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    "checkHotRuntimeControls"
                ],
                "options": {
                    "command": "vitest run tests/runners.test.ts -t \"replays lodash through a real V8 worker\"",
                    "cwd": "packages/check-hot/test-suite",
                    "env": {
                        "CHECK_HOT_ECOSYSTEM": "lodash"
                    }
                }
            },
            "test:ecosystem:date-fns": {
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [
                    "build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    "checkHotRuntimeControls"
                ],
                "options": {
                    "command": "vitest run tests/runners.test.ts -t \"replays date-fns through a real V8 worker\"",
                    "cwd": "packages/check-hot/test-suite",
                    "env": {
                        "CHECK_HOT_ECOSYSTEM": "date-fns"
                    }
                }
            },
            "test:ecosystem:react": {
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [
                    "build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    "checkHotRuntimeControls"
                ],
                "options": {
                    "command": "vitest run tests/runners.test.ts -t \"replays react through a real V8 worker\"",
                    "cwd": "packages/check-hot/test-suite",
                    "env": {
                        "CHECK_HOT_ECOSYSTEM": "react"
                    }
                }
            },
            "test:ecosystem:svelte": {
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [
                    "build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    "checkHotRuntimeControls"
                ],
                "options": {
                    "command": "vitest run tests/runners.test.ts -t \"replays svelte through a real V8 worker\"",
                    "cwd": "packages/check-hot/test-suite",
                    "env": {
                        "CHECK_HOT_ECOSYSTEM": "svelte"
                    }
                }
            },
            "test:ecosystem:three": {
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [
                    "build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    "checkHotRuntimeControls"
                ],
                "options": {
                    "command": "vitest run tests/runners.test.ts -t \"replays three through a real V8 worker\"",
                    "cwd": "packages/check-hot/test-suite",
                    "env": {
                        "CHECK_HOT_ECOSYSTEM": "three"
                    }
                }
            }
        }
    },
    "scripts": {
        "build": "tsc && node scripts/bundle.mjs",
        "audit:threejs": "node threejs/audit.mjs",
        "typecheck": "tsc -p tsconfig.test.json",
        "test:threejs": "vitest run threejs",
        "test": "vitest run",
        "publint": "publint"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "keywords": [
        "date-fns",
        "jit",
        "lodash",
        "react",
        "svelte",
        "test-runner",
        "three.js",
        "v8"
    ],
    "dependencies": {
        "semver": "^7.8.5"
    },
    "devDependencies": {
        "@af-utils/check-hot": "workspace:*",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/semver": "^7.8.0",
        "@types/three": "^0.185.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "date-fns": "^4.4.0",
        "esbuild": "^0.28.2",
        "lodash": "^4.18.1",
        "react": "^19.2.8",
        "svelte": "^5.56.10",
        "three": "^0.185.1",
        "tsx": "^4.23.12",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@af-utils/check-hot": "^0.1.1",
        "date-fns": ">=3 <5",
        "lodash": ">=4 <5",
        "react": ">=18 <20",
        "svelte": ">=5 <6",
        "three": ">=0.180 <0.186"
    },
    "peerDependenciesMeta": {
        "date-fns": {
            "optional": true
        },
        "lodash": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "svelte": {
            "optional": true
        },
        "three": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false
}
