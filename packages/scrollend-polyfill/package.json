{
    "name": "@af-utils/scrollend-polyfill",
    "private": false,
    "version": "0.0.15",
    "description": "Polyfill for scrollend event",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/scrollend-polyfill"
    },
    "homepage": "https://af-utils.vercel.app/scrollend-polyfill",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "scripts": {
        "dev": "tsc -w",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "publint": "publint"
    },
    "files": [
        "dist/*"
    ],
    "type": "module",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "exports": {
        "./README.md": "./README.md",
        ".": {
            "types": "./dist/index.d.ts",
            "node": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "keywords": [
        "scrollend",
        "polyfill"
    ],
    "devDependencies": {
        "@types/node": "^26.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "vitest": "^4.1.11"
    },
    "publishConfig": {
        "access": "public"
    }
}
