{
    "name": "@af-utils/virtual-solid",
    "private": false,
    "version": "1.0.0",
    "description": "Solid components and primitives for rendering large scrollable data",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/virtual/solid"
    },
    "homepage": "https://af-utils.vercel.app/virtual",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "sideEffects": false,
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build && vite build --ssr src/index.ts && tsc && api-extractor run && rm -r dist/types",
        "api-report": "api-extractor run --local",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "publint": "publint"
    },
    "files": [
        "dist/*"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "node": "./dist/index.node.js",
        "default": "./dist/index.js"
    },
    "keywords": [
        "solid",
        "solidjs",
        "virtual",
        "list",
        "dom-recycle",
        "dynamic-size",
        "scroll",
        "scrolling",
        "infinite",
        "virtualized",
        "virtualization",
        "windowing"
    ],
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "jsdom": "^30.0.1",
        "vite": "^8.2.2",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@af-utils/virtual-core": "workspace:*"
    },
    "peerDependencies": {
        "solid-js": "^1.5.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
