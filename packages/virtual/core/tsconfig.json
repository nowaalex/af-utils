{
    "include": ["src/**/*.ts"],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.bench.ts",
        "src/**/__mocks__/**",
        "src/benchmarks/**"
    ],
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationDir": "dist/types",
        "emitDeclarationOnly": true,
        "stripInternal": true,
        "types": ["node"]
    }
}
