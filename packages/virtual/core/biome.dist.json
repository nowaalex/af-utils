{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "files": {
        "includes": ["dist/*.js"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "javascript": {
        "formatter": {
            "arrowParentheses": "asNeeded",
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "none"
        }
    }
}
