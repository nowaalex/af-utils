{
    "name": "@af-utils/virtual-core",
    "private": false,
    "version": "1.0.2",
    "description": "Model for rendering large scrollable data",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/virtual/core"
    },
    "homepage": "https://af-utils.com/virtual",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "nx": {
        "targets": {
            "test": {
                "executor": "nx:noop",
                "dependsOn": [
                    "test:unit",
                    "jit:check"
                ]
            },
            "bench:private": {
                "dependsOn": [
                    "jit:build"
                ]
            },
            "jit:build": {
                "dependsOn": [
                    {
                        "target": "build",
                        "projects": [
                            "@af-utils/check-hot"
                        ]
                    }
                ]
            },
            "jit:check": {
                "dependsOn": [
                    "jit:build"
                ]
            },
            "jit:check:full": {
                "dependsOn": [
                    "jit:build"
                ]
            },
            "jit:check:bun": {
                "dependsOn": [
                    "jit:build"
                ]
            },
            "jit:inspect": {
                "dependsOn": [
                    "jit:build"
                ]
            }
        }
    },
    "scripts": {
        "dev": "tsc -p tsconfig.dev.json && node scripts/build.mjs --watch",
        "build": "tsc && node scripts/build.mjs && api-extractor run && rm -r dist/types && node scripts/check-error-build.mjs",
        "typecheck": "tsc --noEmit",
        "test:unit": "vitest run",
        "test:mutation": "stryker run stryker.config.mjs",
        "bench": "vitest bench --run",
        "bench:size-index-growth": "node scripts/benchmarks/size-index-growth/run.mjs",
        "bench:items:browser": "node scripts/benchmarks/item-registration/run.mjs",
        "bench:private": "node --expose-gc scripts/benchmarks/private-fields/node.mjs",
        "bench:private:browser": "node scripts/benchmarks/private-fields/browser.mjs",
        "jit:build": "node scripts/v8/build.mjs",
        "jit:check": "node scripts/v8/run-checks.mjs",
        "jit:check:full": "node scripts/v8/run-checks.mjs --full",
        "jit:check:bun": "node scripts/v8/run-checks.mjs --bun",
        "jit:inspect": "node scripts/v8/run-checks.mjs --inspect",
        "publint": "publint"
    },
    "files": [
        "dist/*"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#virtual-errors": {
            "development": "./src/errors/development.ts",
            "default": "./src/errors/production.ts"
        }
    },
    "main": "dist/index.node.production.js",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "node": {
            "development": "./dist/index.node.development.js",
            "production": "./dist/index.node.production.js",
            "default": "./dist/index.node.production.js"
        },
        "development": "./dist/index.development.js",
        "production": "./dist/index.production.js",
        "default": "./dist/index.production.js"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "keywords": [
        "virtual",
        "list",
        "recycle",
        "dom recycle",
        "dynamic size",
        "load on demand",
        "scroll",
        "scrolling",
        "infinite",
        "virtualized",
        "virtual",
        "virtualization",
        "windowing"
    ],
    "devDependencies": {
        "@af-utils/check-hot": "workspace:*",
        "@types/node": "^24.13.3",
        "esbuild": "^0.28.2",
        "jsdom": "^30.0.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "publishConfig": {
        "access": "public"
    }
}
