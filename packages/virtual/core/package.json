{
    "name": "@af-utils/virtual-core",
    "private": false,
    "version": "1.0.2",
    "description": "Model for rendering large scrollable data",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/virtual/core"
    },
    "homepage": "https://af-utils.com/virtual",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "scripts": {
        "dev": "tsc -p tsconfig.dev.json && node scripts/build.mjs --watch",
        "build": "tsc && node scripts/build.mjs && pnpm api-extractor && pnpm test:artifacts",
        "typecheck": "tsc --noEmit",
        "api-extractor": "api-extractor run && rm -r dist/types",
        "test": "pnpm test:unit && pnpm test:v8",
        "test:unit": "vitest run",
        "test:v8": "node scripts/v8/run-checks.mjs",
        "test:artifacts": "node scripts/check-error-build.mjs",
        "test:mutation": "stryker run stryker.config.mjs",
        "bench": "vitest bench --run",
        "bench:private": "pnpm jit:build && node --expose-gc scripts/benchmark-private-fields.mjs",
        "bench:private:browser": "node scripts/benchmark-private-fields-browser.mjs",
        "jit:build": "node scripts/v8/build.mjs",
        "jit:check": "pnpm test:v8",
        "jit:inspect": "node scripts/v8/run-checks.mjs --inspect"
    },
    "files": [
        "dist/*"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#virtual-errors": {
            "development": "./src/errors/development.ts",
            "default": "./src/errors/production.ts"
        }
    },
    "main": "dist/index.node.production.js",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "node": {
            "development": "./dist/index.node.development.js",
            "production": "./dist/index.node.production.js",
            "default": "./dist/index.node.production.js"
        },
        "development": "./dist/index.development.js",
        "production": "./dist/index.production.js",
        "default": "./dist/index.production.js"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "virtual",
        "list",
        "recycle",
        "dom recycle",
        "dynamic size",
        "load on demand",
        "scroll",
        "scrolling",
        "infinite",
        "virtualized",
        "virtual",
        "virtualization",
        "windowing"
    ],
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "jsdom": "^30.0.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "publishConfig": {
        "access": "public"
    }
}
