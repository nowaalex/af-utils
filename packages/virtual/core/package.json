{
    "name": "@af-utils/virtual-core",
    "private": false,
    "version": "1.0.2",
    "description": "Model for rendering large scrollable data",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/virtual/core"
    },
    "homepage": "https://af-utils.com/virtual",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "scripts": {
        "dev": "tsc -p tsconfig.dev.json && pnpm esbuild:dev",
        "build": "tsc && pnpm esbuild:build && pnpm api-extractor",
        "esbuild:base": "esbuild src/index*.ts --bundle --format=esm --outdir=dist --platform=neutral",
        "esbuild:build": "pnpm esbuild:base --mangle-props=^_",
        "esbuild:dev": "pnpm esbuild:base --watch",
        "api-extractor": "api-extractor run && rm -r dist/types",
        "test": "vitest run",
        "test:mutation": "stryker run stryker.config.mjs",
        "bench": "vitest bench --run",
        "bench:private": "pnpm jit:build && node --expose-gc scripts/benchmark-private-fields.mjs",
        "bench:private:browser": "node scripts/benchmark-private-fields-browser.mjs",
        "jit:build": "esbuild src/models/SizeIndex/index.ts --bundle --format=esm --platform=node --outfile=.jit/SizeIndex.mjs && esbuild src/models/VirtualScroller/index.ts --bundle --format=esm --platform=node --outfile=.jit/VirtualScroller.mjs && esbuild src/models/VirtualScrollerLayout/index.ts --bundle --format=esm --platform=node --outfile=.jit/VirtualScrollerLayout.mjs && esbuild src/benchmarks/privateFieldFixture.ts --bundle --format=esm --platform=node --outfile=.jit/PrivateFieldFixture.mjs",
        "jit:check": "pnpm jit:build && node --allow-natives-syntax scripts/check-representations.mjs && node --allow-natives-syntax --trace-deopt scripts/check-monomorphism.mjs && node --allow-natives-syntax --trace-deopt scripts/check-private-fields.mjs",
        "jit:inspect": "pnpm jit:build && node --allow-natives-syntax scripts/check-representations.mjs --debug-print"
    },
    "files": [
        "dist/*"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "node": "./dist/index.node.js",
        "default": "./dist/index.js"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "virtual",
        "list",
        "recycle",
        "dom recycle",
        "dynamic size",
        "load on demand",
        "scroll",
        "scrolling",
        "infinite",
        "virtualized",
        "virtual",
        "virtualization",
        "windowing"
    ],
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "jsdom": "^30.0.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "publishConfig": {
        "access": "public"
    }
}
