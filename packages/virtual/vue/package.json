{
    "name": "@af-utils/virtual-vue",
    "private": false,
    "version": "1.0.1",
    "description": "Vue composables and components for rendering large scrollable data",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/virtual/vue"
    },
    "homepage": "https://af-utils.vercel.app/virtual",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "license": "MIT",
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --ssr src/index.ts && tsc && api-extractor run && rm -r dist/types",
        "api-report": "api-extractor run --local",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "publint": "publint"
    },
    "files": [
        "dist/*"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "node": "./dist/index.node.js",
        "default": "./dist/index.js"
    },
    "dependencies": {
        "@af-utils/virtual-core": "workspace:*"
    },
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/server-renderer": "^3.5.42",
        "jsdom": "^30.0.1",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue": "^3.5.42"
    },
    "publishConfig": {
        "access": "public"
    }
}
