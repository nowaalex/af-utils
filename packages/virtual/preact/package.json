{
    "name": "@af-utils/virtual-preact",
    "private": false,
    "version": "1.0.0",
    "description": "Preact components and hooks for rendering large scrollable data",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/virtual/preact"
    },
    "homepage": "https://af-utils.vercel.app/virtual",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "sideEffects": false,
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build && vite build --ssr src/index.ts && tsc && api-extractor run && rm -r dist/types",
        "api-report": "api-extractor run --local",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "publint": "publint"
    },
    "files": [
        "dist/*"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "types": "./dist/index.d.ts",
        "node": "./dist/index.node.js",
        "default": "./dist/index.js"
    },
    "keywords": [
        "preact",
        "virtual",
        "list",
        "dynamic-size",
        "scroll",
        "virtualized",
        "virtualization",
        "windowing"
    ],
    "dependencies": {
        "@af-utils/virtual-core": "workspace:*"
    },
    "peerDependencies": {
        "preact": "^10.23.0"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.6",
        "@types/node": "^26.4.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "jsdom": "^30.0.1",
        "preact": "^10.29.8",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "publishConfig": {
        "access": "public"
    }
}
