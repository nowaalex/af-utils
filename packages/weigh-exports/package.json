{
    "name": "@af-utils/weigh-exports",
    "version": "0.0.7",
    "description": "CLI for measuring minified, gzip, and Brotli sizes of package exports",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowaalex/af-utils.git",
        "directory": "packages/weigh-exports"
    },
    "homepage": "https://github.com/nowaalex/af-utils/tree/master/packages/weigh-exports",
    "bugs": "https://github.com/nowaalex/af-utils/issues",
    "author": {
        "name": "Alex Fomin",
        "email": "nowaalex@gmail.com",
        "url": "https://github.com/nowaalex/"
    },
    "license": "MIT",
    "type": "module",
    "files": [
        "dist/*"
    ],
    "main": "./dist/index.js",
    "exports": "./dist/index.js",
    "bin": {
        "weigh-exports": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc && esbuild ./src/index.ts --bundle --format=esm --platform=node --outdir=dist --external:@swc/* --external:chalk",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "keywords": [
        "bundle-size",
        "brotli",
        "gzip",
        "minify"
    ],
    "devDependencies": {
        "@types/node": "^24.13.3",
        "esbuild": "^0.28.2"
    },
    "dependencies": {
        "@swc/core": "^1.16.0",
        "chalk": "^6.0.0",
        "tinyglobby": "^0.2.17"
    },
    "publishConfig": {
        "access": "public"
    }
}
