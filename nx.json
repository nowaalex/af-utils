{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "master",
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/**/*.bench.*",
            "!{projectRoot}/**/*.spec.*",
            "!{projectRoot}/**/*.test.*",
            "!{projectRoot}/**/__mocks__/**",
            "!{projectRoot}/CHANGELOG.md",
            "!{projectRoot}/README.md"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/api-extractor-base.json",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/pnpm-workspace.yaml",
            "{workspaceRoot}/tsconfig.base.json",
            { "runtime": "node --version" }
        ]
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "test": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["default", "^production"]
        },
        "typecheck": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["default", "^default"]
        },
        "e2e": {
            "cache": false,
            "parallelism": false,
            "dependsOn": [
                {
                    "target": "build",
                    "projects": ["website"]
                }
            ]
        },
        "bench": {
            "cache": false,
            "parallelism": false
        },
        "publint": {
            "cache": true,
            "dependsOn": ["build"],
            "inputs": ["production"]
        }
    },
    "analytics": false
}
