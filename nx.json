{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/**/*.bench.*",
            "!{projectRoot}/**/*.spec.*",
            "!{projectRoot}/**/*.test.*",
            "!{projectRoot}/**/__mocks__/**",
            "!{projectRoot}/CHANGELOG.md",
            "!{projectRoot}/README.md"
        ],
        "browserBuildTarget": [
            "{workspaceRoot}/scripts/browser-build-target.mjs",
            {
                "externalDependencies": [
                    "browserslist",
                    "browserslist-to-esbuild"
                ]
            }
        ],
        "checkHotRuntimeControls": [
            "{workspaceRoot}/.github/workflows/ci.yml",
            { "env": "CHECK_HOT_REQUIRE_RUNTIMES" },
            { "env": "CHECK_HOT_HEAVY_ECOSYSTEM" },
            { "env": "CHECK_HOT_NODE" },
            { "env": "CHECK_HOT_DENO" },
            { "env": "CHECK_HOT_BUN" },
            { "env": "CODEX_PERMISSION_PROFILE" }
        ],
        "sharedGlobals": [
            "{workspaceRoot}/api-extractor-base.json",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/pnpm-workspace.yaml",
            "{workspaceRoot}/tsconfig.base.json",
            { "runtime": "node --version" }
        ]
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production", "browserBuildTarget"]
        },
        "test": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["default", "^production"]
        },
        "typecheck": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["default", "^default"]
        },
        "e2e": {
            "cache": false,
            "parallelism": false,
            "dependsOn": [
                {
                    "target": "build",
                    "projects": ["website"]
                }
            ]
        },
        "bench": {
            "cache": false,
            "parallelism": false
        },
        "publint": {
            "cache": true,
            "dependsOn": ["build"],
            "inputs": ["production"]
        }
    },
    "analytics": false,
    "nxCloudId": "6a8f12dad70befb24e89bec7"
}
